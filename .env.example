# Copy to .env and fill in from Supabase.
# URL: Project Settings -> Data API (or the "Connect" button at the top)
# Key: Project Settings -> API Keys -> Publishable key (sb_publishable_...)
# NEVER put the Secret key (sb_secret_...) here.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Optional: the public address of the web app (e.g. your Vercel URL).
# The shop QR code points here. Leave empty during local testing.
EXPO_PUBLIC_APP_URL=
